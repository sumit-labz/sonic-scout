# Everything here is optional. Sonic Scout searches Wikimedia Commons, Internet
# Archive and Freesound-via-Openverse with no keys at all.

# Claude reads your description. Without it a built-in rule-based reader is used.
ANTHROPIC_API_KEY=
# SONIC_SCOUT_MODEL=claude-opus-5-5

# OpenRouter turns on the Generate screen: Lyria 3 Clip, Drama 3 and Eleven v4.
# Create a key at https://openrouter.ai/keys. Generating spends your credit.
OPENROUTER_API_KEY=

# Freesound: apply at https://freesound.org/apiv2/apply
# The API key enables direct search and previews.
FREESOUND_API_KEY=
# The client ID enables "Connect Freesound", which is required for original WAVs.
# Set the app's callback URL on Freesound to:
#   http://localhost:5178/api/freesound/oauth/callback
FREESOUND_CLIENT_ID=

# Wikimedia asks API clients to identify themselves with contact details.
# Put a project URL or an email here if you are happy to send it to Wikimedia.
# SONIC_SCOUT_CONTACT=

# CC BY-SA allows commercial use, but its ShareAlike term can reach a film the
# sound is synced into. Blocked unless you turn this on, ideally after advice.
# ALLOW_SHARE_ALIKE=false

# SONIC_SCOUT_PORT=5178
